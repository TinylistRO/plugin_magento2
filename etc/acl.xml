<?xml version="1.0"?>
<!--
    Magento 2 replaces the Magento 1 SOAP/XML-RPC role model with ACL resources.
    The two API resources below are what etc/webapi.xml guards and what the
    "Tinylist Connector" integration (etc/integration/api.xml) requests.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Sales::sales">
                    <resource id="Tinylist_Dropshipping::invoice" title="Tinylist: Order Invoice PDF" sortOrder="600"/>
                    <resource id="Tinylist_Dropshipping::tracking" title="Tinylist: Carrier Tracking Status" sortOrder="610"/>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Tinylist_Dropshipping::config" title="Tinylist Dropshipping Section" sortOrder="500"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
