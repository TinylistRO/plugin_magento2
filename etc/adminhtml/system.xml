<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="tinylist_dropshipping" translate="label" type="text" sortOrder="500"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Tinylist Dropshipping</label>
            <tab>general</tab>
            <resource>Tinylist_Dropshipping::config</resource>
            <group id="carrier_status" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Carrier Tracking Status</label>
                <field id="enabled_carriers" translate="label comment" type="multiselect" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled Carriers</label>
                    <comment>Carriers queried when a tracking-status lookup arrives. A tracking number belonging to a carrier that is not selected here comes back as "carrier_not_enabled" instead of being looked up.</comment>
                    <source_model>Tinylist\Dropshipping\Model\Config\Source\Carrier</source_model>
                </field>
            </group>
        </section>

        <section id="payment">
            <group id="tinylist_dropshipping" translate="label" type="text" sortOrder="700"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Tinylist Dropshipping</label>
                <field id="active" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Enabled</label>
                    <comment>Disabled by default. When enabled the method is offered to admins creating orders, and is never rendered on the storefront.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>payment/tinylist_dropshipping/active</config_path>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Title</label>
                    <config_path>payment/tinylist_dropshipping/title</config_path>
                </field>
                <field id="order_status" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>New Order Status</label>
                    <comment>Processing status assigned to orders placed with this method.</comment>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status\Processing</source_model>
                    <config_path>payment/tinylist_dropshipping/order_status</config_path>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Sort Order</label>
                    <frontend_class>validate-number</frontend_class>
                    <config_path>payment/tinylist_dropshipping/sort_order</config_path>
                </field>
            </group>
        </section>
    </system>
</config>
